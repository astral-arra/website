---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Layout from "./Layout.astro";

interface Props {
  title: string;
  intro: string;
  status: string;
  image: ImageMetadata;
  activeUrl: string;
}

const { title, intro, status, image, activeUrl } = Astro.props;
---

<Layout title={title} description={intro} activeUrl={activeUrl}>
  <div class="grid items-center gap-10 md:grid-cols-[1fr_1.1fr] md:gap-14">
    <div>
      <h1 class="text-5xl md:text-6xl">{title}</h1>
      <p class="mt-5 max-w-prose text-lg text-pearl-muted">{intro}</p>
      <div class="gold-rule mt-8"></div>
      <p class="mt-6 max-w-prose text-ice-200">{status}</p>
      <slot />
      <a href="/blog" class="mt-8 inline-block border-b border-neon pb-1 text-ice-100 hover:text-neon">
        Междувременно прочети статиите
      </a>
    </div>
    <Image
      src={image}
      alt=""
      widths={[560, 1120]}
      sizes="(min-width: 768px) 560px, 100vw"
      class="w-full rounded-sm ring-1 ring-night-line"
    />
  </div>
</Layout>
