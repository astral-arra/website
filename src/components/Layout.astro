---
import "@fontsource/forum/cyrillic.css";
import "@fontsource/forum/latin.css";
import "@fontsource-variable/literata/opsz.css";
import "@fontsource-variable/literata/opsz-italic.css";
import "../styles.css";
import MainNav from "./MainNav.astro";
import Footer from "./Footer.astro";
import Analytics from "@vercel/analytics/astro";
import CookieConsent from "./CookieConsent.astro";
import { getLang, swapLang, t } from "../lib/i18n";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  activeUrl?: string;
  isHero?: boolean;
  /** The same page in the other language; null when it has no translation. */
  alternate?: string | null;
  /** The alternate is only a related page (e.g. a tag list), not a translation: no hreflang. */
  looseAlternate?: boolean;
  /** "article" for articles: adds article:* Open Graph tags. */
  type?: "website" | "article";
  published?: Date;
  tags?: string[];
  /** schema.org structured data for this page. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Keep thin pages (tag lists) out of search results. */
  noindex?: boolean;
}

const siteName = "Astral ARRA";
const lang = getLang(Astro.url);
const tr = t(lang);
const {
  title,
  description = tr("siteDescription"),
  image,
  activeUrl = "",
  isHero = false,
  type = "website",
  published,
  tags = [],
  jsonLd,
  noindex = false,
} = Astro.props;
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const given = Astro.props.alternate === undefined ? swapLang(Astro.url.pathname) : Astro.props.alternate;
const alternate = given ? withSlash(given) : null;
const here = new URL(Astro.url.pathname, Astro.site);
const there = alternate && !Astro.props.looseAlternate ? new URL(alternate, Astro.site) : null;
const bgUrl = lang === "bg" ? here : there;
const enUrl = lang === "en" ? here : there;

const fullTitle = !title ? siteName : title.includes(siteName) ? title : `${title} | ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image ?? "/og-default.jpg", Astro.site);
const structured = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title ?? siteName} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    {type === "article" && published && <meta property="article:published_time" content={published.toISOString()} />}
    {type === "article" && <meta property="article:author" content={siteName} />}
    {type === "article" && tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta property="og:locale" content={lang === "en" ? "en_GB" : "bg_BG"} />
    {bgUrl && enUrl && <link rel="alternate" hreflang="bg" href={bgUrl} />}
    {bgUrl && enUrl && <link rel="alternate" hreflang="en" href={enUrl} />}
    {bgUrl && enUrl && <link rel="alternate" hreflang="x-default" href={bgUrl} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? siteName} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {structured.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
    <meta name="theme-color" content="#120A2E" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <div class="grid min-h-screen grid-cols-[minmax(0,1fr)] grid-rows-layout">
      <MainNav url={activeUrl} isHero={isHero} alternate={alternate} />
      <main class:list={["w-full", isHero ? "" : "mx-auto max-w-6xl px-5 py-12 md:px-8 md:py-20"]}>
        <slot />
      </main>
      <Footer />
    </div>
    <CookieConsent />
    <Analytics />
  </body>
</html>
