---
// Magic Corner banner: Metatron's Cube with an affirmation that writes itself in, letter by letter.
import { Image } from "astro:assets";
import banner from "../assets/images/magic-banner.jpg";

interface Props {
  alt: string;
}

const { alt } = Astro.props;
const text = "i am connected to source";
const letters = [...text];
---

<figure class="magic-banner relative mt-10 overflow-hidden rounded-sm">
  <Image
    src={banner}
    alt={alt}
    widths={[800, 1200, 1800, 2400]}
    sizes="(min-width: 1152px) 1088px, 100vw"
    class="block w-full"
    loading="eager"
  />
  <figcaption class="affirmation" aria-label={text} lang="en">
    {
      letters.map((ch, i) => (
        <span aria-hidden="true" style={`--i:${i}`}>
          {ch === " " ? " " : ch}
        </span>
      ))
    }
  </figcaption>
</figure>

<style>
  .magic-banner {
    container-type: inline-size;
  }
  .affirmation {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 7%;
    text-align: center;
    font-family: "Forum", Georgia, serif;
    font-size: clamp(1rem, 4.4cqi, 3.1rem);
    letter-spacing: 0.04em;
    color: #4f4a86;
    text-shadow:
      0 0 18px rgba(255, 255, 255, 0.95),
      0 0 4px rgba(255, 255, 255, 0.8);
    animation: breathe 6s ease-in-out calc(24 * 0.08s + 1.6s) infinite;
  }
  .affirmation span {
    display: inline-block;
    opacity: 0;
    filter: blur(8px);
    transform: translateY(0.35em);
    animation: write-in 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
    animation-delay: calc(0.6s + var(--i) * 0.08s);
  }
  @keyframes write-in {
    to {
      opacity: 1;
      filter: blur(0);
      transform: none;
    }
  }
  @keyframes breathe {
    0%,
    100% {
      text-shadow:
        0 0 18px rgba(255, 255, 255, 0.95),
        0 0 4px rgba(255, 255, 255, 0.8);
    }
    50% {
      text-shadow:
        0 0 34px rgba(255, 255, 255, 1),
        0 0 10px rgba(189, 232, 255, 0.95);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .affirmation,
    .affirmation span {
      animation: none;
      opacity: 1;
      filter: none;
      transform: none;
    }
  }
</style>
