---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import logo from "../assets/images/logo-pearl.png";

const navConfig = await getCollection("nav");
const navItems = navConfig[0].data;
const { url = "", isHero = false } = Astro.props;

const isActive = (href: string) => url === href || (href !== "/" && url.startsWith(`${href}/`));
---

<header
  class:list={[
    "z-30 w-full",
    isHero
      ? "absolute inset-x-0 top-0"
      : "relative border-b border-night-line/70 bg-night-deep/60 backdrop-blur",
  ]}
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-5 py-3 md:px-8">
    <a href="/" class:list={["block shrink-0", isHero && "invisible"]} aria-label="Astral ARRA, начало">
      <Image src={logo} alt="" class="h-14 w-auto md:h-16" loading="eager" widths={[64, 128]} sizes="64px" />
    </a>

    <nav aria-label="Основно меню" class="hidden md:block">
      <ul class="flex items-center gap-1 text-[0.95rem]">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.url}
                aria-current={isActive(item.url) ? "page" : undefined}
                class:list={[
                  "block px-3 py-2 text-pearl-muted hover:text-neon",
                  isActive(item.url) &&
                    "text-pearl underline decoration-gold decoration-1 underline-offset-[10px]",
                ]}
              >
                {item.title}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button
      id="menu-toggle"
      type="button"
      class="p-2 text-pearl hover:text-neon md:hidden"
      aria-controls="mobile-nav"
      aria-expanded="false"
    >
      <span class="sr-only">Отвори менюто</span>
      <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M3 7h18M3 12h18M3 17h18"></path>
      </svg>
    </button>
  </div>

  <nav
    id="mobile-nav"
    aria-label="Основно меню"
    class="hidden border-t border-night-line bg-night-deep/95 backdrop-blur md:hidden"
  >
    <ul class="flex flex-col px-5 py-4">
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.url}
              aria-current={isActive(item.url) ? "page" : undefined}
              class:list={[
                "block py-3 font-display text-2xl hover:text-neon",
                isActive(item.url) ? "text-gold" : "text-pearl",
              ]}
            >
              {item.title}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("#menu-toggle");
  const panel = document.querySelector<HTMLElement>("#mobile-nav");
  const label = toggle?.querySelector(".sr-only");

  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!open));
    panel?.classList.toggle("hidden", open);
    if (label) label.textContent = open ? "Отвори менюто" : "Затвори менюто";
  });
</script>
