---
import { getCollection } from "astro:content";
import { getLang, localize, t } from "../lib/i18n";

interface Props {
  current?: string;
}

const { current } = Astro.props;
const lang = getLang(Astro.url);
const tr = t(lang);
const sections = (await getCollection(lang === "en" ? "sections-en" : "sections")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<nav aria-label={tr("sections")} class="mt-8">
  <ul class="flex flex-wrap gap-2 text-[0.95rem]">
    <li>
      <a
        href={localize("/blog", lang)}
        aria-current={!current ? "page" : undefined}
        class:list={[
          "block rounded-full border px-4 py-1.5",
          !current
            ? "border-gold text-gold-300"
            : "border-night-line text-pearl-muted hover:border-neon hover:text-neon",
        ]}
      >
        {tr("all")}
      </a>
    </li>
    {
      sections.map((s) => (
        <li>
          <a
            href={localize(`/blog/categories/${s.slug}`, lang)}
            aria-current={current === s.slug ? "page" : undefined}
            class:list={[
              "block rounded-full border px-4 py-1.5",
              current === s.slug
                ? "border-gold text-gold-300"
                : "border-night-line text-pearl-muted hover:border-neon hover:text-neon",
            ]}
          >
            {s.data.title}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
