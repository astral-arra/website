---
import { Image } from "astro:assets";
import { getEntry, type CollectionEntry } from "astro:content";
import Layout from "../components/Layout.astro";
import { formatDate } from "../lib/posts";

interface Props {
  post: CollectionEntry<"blog" | "portal">;
  section: { url: string; title: string };
}

const { post, section } = Astro.props;
const { title, date, author, tags = [], image, description } = post.data;
const { Content } = await post.render();
const topic = post.data.section ? await getEntry(post.data.section) : undefined;
---

<Layout title={title} description={description ?? title} image={image?.src} activeUrl={section.url}>
  <article class="article mx-auto max-w-[52rem]">
    <nav aria-label="Път до статията" class="flex flex-wrap gap-x-2 text-sm text-pearl-dim">
      <a href={section.url} class="text-ice-300 hover:text-neon">{section.title}</a>
      {
        topic && (
          <>
            <span aria-hidden="true">/</span>
            <a href={`/blog/categories/${topic.slug}`} class="text-ice-300 hover:text-neon">
              {topic.data.title}
            </a>
          </>
        )
      }
    </nav>
    <h1 class="mt-4 text-4xl leading-tight md:text-6xl">{title}</h1>
    {post.data.subtitle && <p class="mt-4 font-display text-xl text-ice-100 md:text-2xl">{post.data.subtitle}</p>}
    <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-pearl-dim">
      <span>{author}</span>
      {date && <time datetime={date.toISOString()} class="text-gold">{formatDate(date)}</time>}
    </div>
    <div class="gold-rule mt-6"></div>

    {
      image && (
        <Image src={image} alt="" widths={[832, 1664]} sizes="(min-width: 900px) 832px, 100vw" class="mt-10 w-full rounded-sm" />
      )
    }

    <div class="article-body prose prose-lg prose-arra mt-10 max-w-none">
      <Content />
    </div>

    {
      tags.length > 0 && (
        <ul class="mt-12 flex flex-wrap gap-2 border-t border-night-line pt-6 text-sm" aria-label="Тагове">
          {tags.map((tag) => (
            <li>
              <a
                href={`${section.url}/tags/${tag}`}
                class="block rounded-full border border-amethyst-600/70 px-3 py-1 text-amethyst-200 hover:border-neon hover:text-neon"
              >
                {tag}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </article>
</Layout>

<script>
  // Turns plain YouTube links inside an article into embedded players.
  // Based on eleventy-plugin-youtube-embed (https://github.com/gfscott/eleventy-plugin-youtube-embed)
  const idPattern =
    /(?:youtube\.com\/(?:watch\?v=|embed\/)|youtu\.be\/)([A-Za-z0-9_-]{11})/;

  document.querySelectorAll<HTMLAnchorElement>(".prose p > a[href]:only-child").forEach((link) => {
    const id = link.href.match(idPattern)?.[1];
    if (!id || link.parentElement?.textContent?.trim() !== link.textContent?.trim()) return;
    const params = new URL(link.href).searchParams;
    params.delete("v");
    const embed = document.createElement("iframe");
    embed.title = link.textContent?.trim() || "YouTube видео";
    embed.className = "aspect-video w-full rounded-sm";
    embed.allow =
      "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
    embed.allowFullscreen = true;
    embed.loading = "lazy";
    embed.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(id)}?${params}`;
    link.insertAdjacentElement("beforebegin", embed);
    link.hidden = true;
  });
</script>
