---
import { getCollection } from "astro:content";
import Layout from "../components/Layout.astro";
import PostList from "../components/PostList.astro";

const posts = await getCollection("blog");
---

<Layout
  title="Статии"
  description="Статии на Astral ARRA за езотерика, гностицизъм, астрология и Хюман дизайн."
  activeUrl="/blog"
>
  <h1 class="text-5xl md:text-6xl">Статии</h1>
  <p class="mt-4 max-w-prose text-lg text-pearl-muted">
    Текстове за езотерика, гностицизъм, астрология и Хюман дизайн.
  </p>
  <div class="mt-12">
    <PostList posts={posts} baseUrl="/blog" />
  </div>
</Layout>
