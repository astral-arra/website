---
import { getCollection } from "astro:content";
import CategoryPage from "../../../views/CategoryPage.astro";

export async function getStaticPaths() {
  const sections = await getCollection("sections");
  const posts = await getCollection("blog");
  return sections.map((section) => ({
    params: { category: section.slug },
    props: { section, posts: posts.filter((p) => p.data.section?.slug === section.slug) },
  }));
}

const { section, posts } = Astro.props;
---

<CategoryPage section={section} posts={posts} />
