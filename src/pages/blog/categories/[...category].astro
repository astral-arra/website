---
import { getCollection } from "astro:content";
import Layout from "../../../components/Layout.astro";
import PostList from "../../../components/PostList.astro";
import { groupBy } from "../../../lib/posts";

export async function getStaticPaths() {
  const groups = groupBy(await getCollection("blog"), "categories");
  return Object.entries(groups).map(([category, posts]) => ({
    params: { category },
    props: { posts },
  }));
}

const { category } = Astro.params;
const { posts } = Astro.props;
---

<Layout title={`${category} | Статии`} activeUrl="/blog">
  <a href="/blog" class="text-sm text-ice-300 hover:text-neon">Статии</a>
  <h1 class="mt-3 text-4xl md:text-5xl">{category}</h1>
  <div class="mt-10">
    <PostList posts={posts} baseUrl="/blog" />
  </div>
</Layout>
