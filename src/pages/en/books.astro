---
import Layout from "../../components/Layout.astro";
import FreeDownload from "../../components/FreeDownload.astro";
import BookCover from "../../components/BookCover.astro";
import { mailto } from "../../lib/contact";

const books = [
  { title: "Euphoria", subtitle: "The Book of Life", original: "Еуфория", motif: "glow" as const },
  { title: "A World Inhabited by Demons", original: "Свят населен с демони", motif: "sigil" as const },
  { title: "Spider Gnosis", original: "Spider Gnosis", motif: "web" as const },
  { title: "Golden Threads", original: "Златни нишки", motif: "threads" as const },
];
---

<Layout
  title="Books"
  description="Books by Astral ARRA: Euphoria, A World Inhabited by Demons, Spider Gnosis and Golden Threads."
  activeUrl="/en/books"
>
  <h1 class="text-5xl md:text-6xl">Books</h1>
  <p class="mt-4 max-w-prose text-lg text-pearl-muted">
    The books of Astral ARRA, written in Bulgarian. Soon you will be able to order them here. Until then, write
    to me if you would like to know more or to reserve a copy.
  </p>

  <ul class="mt-14 grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-4">
    {
      books.map((book) => (
        <li>
          <BookCover title={book.title} subtitle={book.subtitle} motif={book.motif} />
          <h2 class="mt-6 text-2xl xl:text-3xl">{book.title}</h2>
          {book.subtitle && <p class="mt-1 text-ice-100">{book.subtitle}</p>}
          {book.original !== book.title && <p class="mt-1 text-sm text-pearl-dim" lang="bg">{book.original}</p>}
          <p class="mt-3 text-sm text-gold">Coming soon</p>
          <a
            href={mailto(`Book: ${book.title}`)}
            class="mt-4 inline-block border-b border-neon pb-1 text-ice-100 hover:text-neon"
          >
            Ask about the book
          </a>
        </li>
      ))
    }
  </ul>

  <FreeDownload />
</Layout>
