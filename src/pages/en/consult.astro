---
import { Image } from "astro:assets";
import Layout from "../../components/Layout.astro";
import { EMAIL, mailto } from "../../lib/contact";
import img from "../../assets/images/consultation.png";
---

<Layout title="Tarot readings" description="Personal tarot readings with Astral ARRA. Details on request by email." activeUrl="/en/consult">
  <div class="grid items-center gap-10 md:grid-cols-[1fr_1.1fr] md:gap-14">
    <div>
      <h1 class="text-5xl md:text-6xl">Tarot readings</h1>
      <p class="mt-6 max-w-prose font-display text-2xl leading-snug text-ice-100 md:text-3xl">
        I give personal tarot readings.
      </p>
      <p class="mt-5 max-w-prose text-lg text-pearl-muted">
        For details, prices and available times, write to me at <a href={mailto("Tarot reading")} class="text-ice-200 underline decoration-ice-400/60 underline-offset-4 hover:text-neon">{EMAIL}</a>.
      </p>
      <div class="gold-rule mt-8"></div>
      <a
        href={mailto("Tarot reading")}
        class="mt-8 inline-block rounded-full border border-neon px-6 py-3 text-ice-100 shadow-neon hover:bg-neon/10 hover:text-pearl"
      >
        Write to me about a reading
      </a>
    </div>
    <Image
      src={img}
      alt=""
      widths={[560, 1120]}
      sizes="(min-width: 768px) 560px, 100vw"
      class="w-full rounded-sm ring-1 ring-night-line"
    />
  </div>
</Layout>
