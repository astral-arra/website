---
import { getCollection } from "astro:content";
import Layout from "../components/Layout.astro";
import PostList from "../components/PostList.astro";

const posts = await getCollection("portal");
---

<Layout
  title="Синхромистичен портал"
  description="Лични преживявания със синхроничности, времеви линии и знаци по пътя."
  activeUrl="/portal"
>
  <h1 class="text-5xl md:text-6xl">Синхромистичен портал</h1>
  <p class="mt-4 max-w-prose text-lg text-pearl-muted">
    Лични преживявания със синхроничности, времеви линии и знаци по пътя.
  </p>
  <div class="mt-12">
    <PostList posts={posts} baseUrl="/portal" />
  </div>
</Layout>
