---
import { getCollection } from "astro:content";
import Layout from "../../../components/Layout.astro";
import PostList from "../../../components/PostList.astro";
import { groupBy } from "../../../lib/posts";

export async function getStaticPaths() {
  const groups = groupBy(await getCollection("portal"), "tags");
  return Object.entries(groups).map(([tag, posts]) => ({ params: { tag }, props: { posts } }));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<Layout title={`${tag} | Синхромистичен портал`} activeUrl="/portal">
  <a href="/portal" class="text-sm text-ice-300 hover:text-neon">Синхромистичен портал</a>
  <h1 class="mt-3 text-4xl md:text-5xl">Таг: {tag}</h1>
  <div class="mt-10">
    <PostList posts={posts} baseUrl="/portal" />
  </div>
</Layout>
