---
import { Image } from "astro:assets";
import Layout from "../components/Layout.astro";
import SubSections from "../components/SubSections.astro";
import banner from "../assets/images/dreams.jpg";

const parts = [
  {
    id: "sonovnik",
    title: "Съновник",
    text: "Значенията на символите, които срещаме насън.",
  },
  {
    id: "rechnik",
    title: "Речник",
    text: "Термините за сънищата, астралното пътуване и съзнателното сънуване, обяснени накратко.",
  },
  {
    id: "moite-sanishta",
    title: "Моите сънища",
    text: "Сънищата, които помня най-ясно, и какво ми показаха.",
  },
];
---

<Layout title="Съновник" description="Съновник, речник на термините за сънища и астрално пътуване, и моите сънища." image={banner.src} activeUrl="/sonovnik">
  <h1 class="text-5xl md:text-6xl">Съновник</h1>
  <p class="mt-4 max-w-prose text-lg text-pearl-muted">Сънища, символи и астрални пътувания.</p>
  <Image src={banner} alt="" widths={[915]} sizes="(min-width: 1152px) 1088px, 100vw" class="mt-10 w-full rounded-sm" />
  <SubSections parts={parts} />
</Layout>
