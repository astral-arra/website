---
import type { CollectionEntry } from "astro:content";
import Layout from "../components/Layout.astro";
import PostList from "../components/PostList.astro";
import SectionNav from "../components/SectionNav.astro";
import UpcomingList from "../components/UpcomingList.astro";
import { getLang, localize, t } from "../lib/i18n";
import { breadcrumbs } from "../lib/seo";

interface Props {
  section: CollectionEntry<"sections" | "sections-en">;
  posts: CollectionEntry<"blog" | "blog-en">[];
}

const { section, posts } = Astro.props;
const lang = getLang(Astro.url);
const tr = t(lang);
const { Content } = await section.render();
const { title, tagline, upcoming } = section.data;
const blog = localize("/blog", lang);
const description = lang === "en" ? `${tr("sectionDescription")} “${title}”. ${tagline}` : `${tr("sectionDescription")} „${title}“. ${tagline}`;
const crumbs = breadcrumbs([
  { name: "Astral ARRA", path: localize("/", lang) },
  { name: tr("articles"), path: blog },
  { name: title, path: Astro.url.pathname },
]);
---

<Layout
  title={`${title} | ${tr("articles")}`}
  description={description}
  image={section.data.image?.src}
  activeUrl={blog}
  jsonLd={crumbs}
>
  <a href={blog} class="text-sm text-ice-300 hover:text-neon">{tr("articles")}</a>
  <h1 class="mt-3 text-5xl md:text-6xl">{title}</h1>
  <p class="mt-5 max-w-3xl font-display text-2xl leading-snug text-ice-100 md:text-3xl">{tagline}</p>
  {
    section.body.trim() && (
      <div class="prose prose-lg prose-arra mt-8 max-w-3xl">
        <Content />
      </div>
    )
  }
  <SectionNav current={section.slug} />

  {
    posts.length > 0 && (
      <div class="mt-12">
        <PostList posts={posts} baseUrl={blog} />
      </div>
    )
  }

  <UpcomingList items={upcoming} />
</Layout>
